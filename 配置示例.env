# DeepSeek 页面单次 Key 默认配置（无需在此保存密钥）
ALPHALENS_DEEPSEEK_BASE_URL=https://api.deepseek.com
# DeepSeek 当前未在本项目配置 Embedding；只有另接兼容服务时才填写
ALPHALENS_DEEPSEEK_EMBEDDING_MODEL=

# 可选：服务端固定的 OpenAI 兼容 API；填写密钥后将 ALPHALENS_AI_MODE 设为 api
ALPHALENS_AI_MODE=off
OPENAI_API_KEY=
ALPHALENS_LLM_BASE_URL=https://api.openai.com/v1
ALPHALENS_LLM_MODEL=gpt-5-mini
ALPHALENS_EMBEDDING_MODEL=text-embedding-3-small
ALPHALENS_AI_JSON_MODE=schema
ALPHALENS_AI_TIMEOUT=45

# 本地模型示例：服务必须同时兼容 /v1/chat/completions 和 /v1/embeddings
# ALPHALENS_AI_MODE=local
# ALPHALENS_LLM_BASE_URL=http://127.0.0.1:11434/v1
# ALPHALENS_LLM_MODEL=你的本地对话模型
# ALPHALENS_EMBEDDING_MODEL=你的本地向量模型
# ALPHALENS_AI_JSON_MODE=object
